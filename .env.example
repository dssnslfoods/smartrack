# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูก push ขึ้น GitHub)

# วิธีหา: Supabase Dashboard → ปุ่ม Connect (มุมบนขวา) → Session pooler → คัดลอก URI
# แล้วแทนที่ [YOUR-PASSWORD] ด้วยรหัสผ่านจริง
#
# หมายเหตุ: โปรเจกต์ Supabase ที่สร้างใหม่ส่วนใหญ่ "ต่อตรง" (db.<ref>.supabase.co) ไม่ได้
#          เพราะไม่ได้เปิด IPv4 ให้ ต้องใช้ Connection Pooler แทน
#          พอร์ต 5432 = Session pooler (เซิร์ฟเวอร์ที่รันตลอด)
#          พอร์ต 6543 = Transaction pooler (serverless เช่น Cloud Functions)
#
# ถ้ารหัสผ่านมีอักขระพิเศษต้องเข้ารหัส:  @ → %40   : → %3A   / → %2F   # → %23
DATABASE_URL=postgresql://postgres.<project-ref>:<รหัสผ่าน>@aws-0-<region>.pooler.supabase.com:5432/postgres

# รหัสผ่าน admin ที่จะสร้างตอนบูตครั้งแรก (ถ้าไม่ตั้ง ระบบจะสุ่มแล้วพิมพ์ใน log ครั้งเดียว)
RAG_ADMIN_PASSWORD=

# ตั้งเป็น demo ถ้าต้องการข้อมูลตัวอย่างสำหรับทดลองใช้ (อย่าใช้กับระบบจริง)
RAG_SEED=

PORT=4000
